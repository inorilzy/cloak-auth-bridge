{
  "manifest_version": 3,
  "name": "Cloak Auth Bridge",
  "description": "将白名单站点的 Chrome 登录态安全同步给本地 Cloak Auth Bridge。",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cloak Auth Bridge"
  }
}

